flowchart TD
    %% WinDevice Inspector - TASK-0001 Stage A (R2) Project & Module Dependency Graph
    %% Strictly aligned with TASK-0001_阶段A_R2_项目结构方案.md
    %% Note: C-02 (Persistence boundary) and .sln location remain pending Project Owner approval.

    subgraph Phase1_Src["Phase 1 源码项目（TASK-0001 阶段 B 获批后拟建）"]
        APP["WinDeviceInspector.App<br/>(net10.0-windows / WPF)<br/>空状态首页、扫描确认弹窗、进度/取消、<br/>历史浏览、统一导出隐私提示与保存框"]
        CORE["WinDeviceInspector.Core<br/>(net10.0 / 纯类库，零 WPF 与磁盘 I/O 依赖)<br/>全量 PnP DeviceCatalog、双轴 CollectionStatus/DiagnosticFinding、<br/>Schema v1 契约与演进校验、CollectionCompleteness、<br/>服务层扫描确认门禁、统一导出取消门禁、核心接口"]
        COLL["WinDeviceInspector.Collectors<br/>(net10.0-windows / 只读采集)<br/>PS 7 & 5.1 双版本 Runner、PnpDevice / Driver /<br/>HardwareInventory（Phase 1）；<br/>InterfaceAndBus / SensorAndHealth / ReliabilityEvent（Phase 2-3）"]
        PERS["WinDeviceInspector.Persistence<br/>(net10.0 / C-02 推荐独立项目，待批准)<br/>LocalAppData 扫描历史、原子 JSON 读写、损坏容错、<br/>原始证据 JSON 写出（若批准方案 2 则并入 Core/Persistence）"]
    end

    subgraph Phase1_Tests["Phase 1 测试项目（TASK-0001 阶段 B 获批后拟建）"]
        TEST_CORE["WinDeviceInspector.Core.Tests<br/>(net10.0 / xUnit / 纯合成数据)<br/>确认门禁、双轴状态、PnP 分类/去重、Schema v1、<br/>完整性统计、本地历史容错、导出取消门禁"]
        TEST_COLL["WinDeviceInspector.Collectors.Tests<br/>(net10.0-windows / xUnit / 纯合成数据)<br/>PnP/ProblemCode 解析、畸形 JSON/stderr、<br/>PS 7 & 5.1 双版本集成测试、超时取消杀进程树"]
    end

    subgraph Future_Src["后续阶段拆分项目（Phase 1 暂不创建）"]
        DIAG["WinDeviceInspector.Diagnostics<br/>[Phase 3 触发创建]<br/>事件时间线规范化、跨源证据关联、<br/>传感器离群校验与诊断结论综合（严禁启动扫描）"]
        REPT["WinDeviceInspector.Reporting<br/>[Phase 4 触发创建]<br/>四件套报告包：完整诊断数据.json +<br/>设备状态清单.xlsx（11 表）+ 诊断总览报告.html +<br/>AI分析说明.md + ZipArchive 打包 + 可选脱敏副本"]
    end

    subgraph Future_Tests["后续阶段测试项目（随对应阶段创建）"]
        TEST_DIAG["WinDeviceInspector.Diagnostics.Tests<br/>[Phase 3] 事件时间线与关联断言"]
        TEST_REPT["WinDeviceInspector.Reporting.Tests<br/>[Phase 4] 11 表 XLSX/HTML/ZIP 与脱敏不改原件"]
    end

    %% Phase 1 Compile-Time & Composition Dependencies (Strictly Acyclic DAG)
    APP -->|调用接口、扫描门禁与导出门禁| CORE
    APP -->|组合根装配具体采集器| COLL
    APP -->|组合根装配历史存储与原始写出| PERS

    COLL -->|实现采集接口 / 输出双轴与 Schema v1| CORE
    PERS -->|实现历史与原始证据写出接口| CORE

    TEST_CORE -->|单元测试| CORE
    TEST_CORE -->|临时目录持久化测试| PERS
    TEST_COLL -->|契约与双轴断言| CORE
    TEST_COLL -->|解析与双版本 PS 测试| COLL

    %% Future Phase Dependencies (Dashed)
    DIAG -.->|仅只读消费 Core 快照，严禁依赖 Collectors| CORE
    REPT -.->|消费 Core 契约与只读快照，严禁依赖 App/Collectors| CORE
    REPT -.->|可选只读消费诊断关联结果| DIAG
    APP -.->|Phase 3-4 组合根按需装配| DIAG
    APP -.->|Phase 4 组合根按需装配| REPT

    TEST_DIAG -.-> DIAG
    TEST_DIAG -.-> CORE
    TEST_REPT -.-> REPT
    TEST_REPT -.-> CORE

    %% Hard Architectural Red Lines
    RULE["强制架构红线（严禁违规边）：<br/>1. 严禁任何循环依赖（严格 DAG）<br/>2. Core 严禁依赖 App/WPF、Collectors、Persistence、Diagnostics 或 Reporting<br/>3. Persistence、Diagnostics、Reporting 均严禁依赖 Collectors（读历史/诊断/导出绝不可能触发扫描）<br/>4. 采集执行成功 != 设备健康正常；取消导出绝不弹窗不写文件"]

